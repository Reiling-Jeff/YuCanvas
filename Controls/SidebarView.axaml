<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:YuCanvas.Models"
             xmlns:conv="clr-namespace:Avalonia.Data.Converters;assembly=Avalonia.Base"
             xmlns:components="using:YuCanvas.Views.Components"
             xmlns:viewModels="clr-namespace:YuCanvas.Models.ViewModels"
             x:DataType="viewModels:SideBarViewModel"
             mc:Ignorable="d" d:DesignWidth="260" d:DesignHeight="820"
             x:Class="YuCanvas.Controls.SidebarView">

    <Border Background="{DynamicResource BgSidebarBrush}"
            BorderBrush="{DynamicResource HairlineBrush}"
            BorderThickness="0,0,1,0">
        <Grid RowDefinitions="Auto,*,Auto" Margin="16,22,16,20">

            <StackPanel Grid.Row="0" Spacing="26">
                <StackPanel Orientation="Horizontal" Spacing="12" Margin="8,0,0,0">
                    <Border Width="42" Height="42" CornerRadius="8"
                            Background="{DynamicResource AccentBrush}"
                            BoxShadow="{StaticResource ShadowFlat}">
                        <TextBlock Text="Y" FontSize="20" FontWeight="Bold"
                                   FontFamily="monospace"
                                   Foreground="{DynamicResource InkOnAccentBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center" Spacing="1">
                        <TextBlock Text="YuCanvas" FontSize="18" FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock Text="Learning Hub" FontSize="11"
                                   Foreground="{DynamicResource TextMutedBrush}" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Spacing="4">
                    <TextBlock Text="MENÜ" Classes="eyebrow" Margin="10,0,0,8" />

                    <Button Classes="navitem" Classes.active="{Binding IsDashboardActive}"
                            Command="{Binding ShowDashboardCommand}" 
                            HorizontalContentAlignment="Stretch">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="14">
                                <TextBlock Text="◈" FontSize="16" VerticalAlignment="Center" />
                                <TextBlock Text="Dashboard" VerticalAlignment="Center" />
                            </StackPanel>
                            <components:Badge Grid.Column="2" VerticalAlignment="Center" />
                        </Grid>
                    </Button>

                    <Button Classes="navitem" Classes.active="{Binding IsAssignmentsActive}"
                            Command="{Binding ShowAssignmentsCommand}"
                            HorizontalContentAlignment="Stretch">
                        <Grid ColumnDefinitions="Auto,*,Auto,*,Auto">
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="14">
                                <TextBlock Text="✎" FontSize="16" VerticalAlignment="Center" />
                                <TextBlock Text="Aufgaben" VerticalAlignment="Center" />
                            </StackPanel>
                            <Border Grid.Column="2" Classes="pill" Background="{DynamicResource BgInsetBrush}"
                                    IsVisible="True"
                                    BorderBrush="{DynamicResource HairlineBrush}" VerticalAlignment="Center">
                                <TextBlock Text="5" FontSize="11" FontWeight="SemiBold"
                                           FontFamily="monospace"
                                           Foreground="{DynamicResource AccentBrightBrush}" />
                            </Border>
                            
                            <components:Badge Grid.Column="4"/>
                        </Grid>
                    </Button>

                    <Button Classes="navitem disabled"
                            Command="{Binding ShowComingSoonCommand}"
                            CommandParameter="Noten"
                            HorizontalContentAlignment="Stretch">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="14">
                                <TextBlock Text="◎" FontSize="16" VerticalAlignment="Center" />
                                <TextBlock Text="Noten" VerticalAlignment="Center" />
                            </StackPanel>
                            <components:Badge Grid.Column="2" Label="Soon"/>
                        </Grid>
                    </Button>

                    <Button Classes="navitem disabled"
                            Command="{Binding ShowComingSoonCommand}"
                            CommandParameter="Kalender" HorizontalContentAlignment="Stretch">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="14">
                                <TextBlock Text="▤" FontSize="16" VerticalAlignment="Center" />
                                <TextBlock Text="Kalender" VerticalAlignment="Center" />
                            </StackPanel>
                            <components:Badge Grid.Column="2" Label="Soon"/>
                        </Grid>
                    </Button>

                    <Button Classes="navitem disabled"
                            Command="{Binding ShowComingSoonCommand}"
                            CommandParameter="Module" HorizontalContentAlignment="Stretch">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="14">
                                <TextBlock Text="❏" FontSize="16" VerticalAlignment="Center" />
                                <TextBlock Text="Module" VerticalAlignment="Center" />
                            </StackPanel>
                            <components:Badge Grid.Column="2" Label="Soon"/>
                        </Grid>
                    </Button>

                    <Button Classes="navitem disabled"
                            Command="{Binding ShowComingSoonCommand}"
                            CommandParameter="Ankündigungen" HorizontalContentAlignment="Stretch">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="14">
                                <TextBlock Text="◭" FontSize="16" VerticalAlignment="Center" />
                                <TextBlock Text="Ankündigungen" VerticalAlignment="Center" />
                            </StackPanel>
                            <components:Badge Grid.Column="2" Label="Soon"/>
                        </Grid>
                    </Button>

                    <Button Classes="navitem disabled"
                            Command="{Binding ShowComingSoonCommand}"
                            CommandParameter="Dateien" HorizontalContentAlignment="Stretch">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="14">
                                <TextBlock Text="⬇" FontSize="16" VerticalAlignment="Center" />
                                <TextBlock Text="Dateien" VerticalAlignment="Center" />
                            </StackPanel>
                            <components:Badge Grid.Column="2" Label="Soon"/>
                        </Grid>
                    </Button>

                    <Button Classes="navitem disabled"
                            Command="{Binding ShowComingSoonCommand}"
                            CommandParameter="Nachrichten" HorizontalContentAlignment="Stretch">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="14">
                                <TextBlock Text="✉" FontSize="16" VerticalAlignment="Center" />
                                <TextBlock Text="Nachrichten" VerticalAlignment="Center" />
                            </StackPanel>
                            <components:Badge Grid.Column="2" Label="Soon"/>
                        </Grid>
                    </Button>
                </StackPanel>

                <TextBlock Text="{Binding ComingSoonMessage}" Classes="caption"
                           Foreground="{DynamicResource WarnBrush}"
                           Margin="10,0,10,0" TextWrapping="Wrap"
                           IsVisible="{Binding ComingSoonMessage, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}" />
            </StackPanel>

            <Border Grid.Row="2" Classes="glass" CornerRadius="10" Padding="14">
                <StackPanel Spacing="12">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Border Width="40" Height="40" CornerRadius="8"
                                Background="{DynamicResource BgInsetBrush}"
                                BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1">
                            <TextBlock Text="LM" FontSize="13" FontWeight="SemiBold"
                                       FontFamily="monospace"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel VerticalAlignment="Center" Spacing="1">
                            <TextBlock Text="{Binding StudentName}" FontSize="13.5" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="Informatik · 4. Sem." FontSize="11"
                                       Foreground="{DynamicResource TextMutedBrush}" />
                        </StackPanel>
                    </StackPanel>
                    <Button Classes="ghost" Classes.active="{Binding IsSettingsActive}"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center" Padding="0,9"
                            Command="{Binding ShowSettingsCommand}">
                        <TextBlock Text="Einstellungen" FontSize="13" />
                    </Button>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>