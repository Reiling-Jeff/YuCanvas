<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Surfaces: warm, neutral charcoal — no navy, no blue undertone -->
    <Color x:Key="BgDeep">#121110</Color>
    <Color x:Key="BgBase">#17150F</Color>
    <Color x:Key="BgRaised">#1E1B17</Color>
    <Color x:Key="BgRaisedHover">#252119</Color>
    <Color x:Key="BgSidebar">#0E0D0C</Color>
    <Color x:Key="BgInset">#0B0A09</Color>

    <!-- Hairlines instead of glow/blur -->
    <Color x:Key="Border">#2B2823</Color>
    <Color x:Key="BorderBright">#423C31</Color>
    <Color x:Key="BorderStrong">#5C5445</Color>

    <!-- Accent: a single flat marker-amber, not a purple gradient -->
    <Color x:Key="Accent">#E2A63C</Color>
    <Color x:Key="AccentBright">#EFBB57</Color>
    <Color x:Key="AccentDeep">#B9812A</Color>
    <Color x:Key="InkOnAccent">#171310</Color>

    <Color x:Key="TextPrimary">#F1ECE1</Color>
    <Color x:Key="TextSecondary">#AFA694</Color>
    <Color x:Key="TextMuted">#766D5D</Color>
    <Color x:Key="TextOnAccent">#171310</Color>

    <!-- Semantic: red pen / correction green / ledger tones, not neon -->
    <Color x:Key="SuccessGreen">#6FA35B</Color>
    <Color x:Key="WarnOrange">#CC7A2E</Color>
    <Color x:Key="DangerRed">#C1483C</Color>
    <Color x:Key="InfoTeal">#4E8B86</Color>

    <SolidColorBrush x:Key="BgDeepBrush" Color="{StaticResource BgDeep}" />
    <SolidColorBrush x:Key="BgBaseBrush" Color="{StaticResource BgBase}" />
    <SolidColorBrush x:Key="BgRaisedBrush" Color="{StaticResource BgRaised}" />
    <SolidColorBrush x:Key="BgRaisedHoverBrush" Color="{StaticResource BgRaisedHover}" />
    <SolidColorBrush x:Key="BgSidebarBrush" Color="{StaticResource BgSidebar}" />
    <SolidColorBrush x:Key="BgInsetBrush" Color="{StaticResource BgInset}" />

    <SolidColorBrush x:Key="HairlineBrush" Color="{StaticResource Border}" />
    <SolidColorBrush x:Key="HairlineBrightBrush" Color="{StaticResource BorderBright}" />
    <SolidColorBrush x:Key="HairlineStrongBrush" Color="{StaticResource BorderStrong}" />

    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource Accent}" />
    <SolidColorBrush x:Key="AccentBrightBrush" Color="{StaticResource AccentBright}" />
    <SolidColorBrush x:Key="AccentDeepBrush" Color="{StaticResource AccentDeep}" />
    <SolidColorBrush x:Key="InkOnAccentBrush" Color="{StaticResource InkOnAccent}" />

    <!-- Kept for the Badge component, which already referenced these keys -->
    <SolidColorBrush x:Key="AccentButtonBackground" Color="{StaticResource Accent}" Opacity="0.16" />
    <SolidColorBrush x:Key="AccentButtonForeground" Color="{StaticResource AccentBright}" />

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimary}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondary}" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMuted}" />
    <SolidColorBrush x:Key="TextOnAccentBrush" Color="{StaticResource TextOnAccent}" />

    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessGreen}" />
    <SolidColorBrush x:Key="WarnBrush" Color="{StaticResource WarnOrange}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerRed}" />
    <SolidColorBrush x:Key="InfoBrush" Color="{StaticResource InfoTeal}" />

    <!-- Hard, unblurred "stamp" shadows instead of soft coloured glows -->
    <BoxShadows x:Key="ShadowFlat">3 3 0 0 #3A000000</BoxShadows>
    <BoxShadows x:Key="ShadowFlatHover">6 6 0 0 #46000000</BoxShadows>
    <BoxShadows x:Key="ShadowFlatFlush">0 0 0 0 #00000000</BoxShadows>

</ResourceDictionary>
