<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Buttons: flat fill + hard offset shadow that "presses in" on click,
         instead of a scaling glow. -->
    <Style Selector="Button.accent">
        <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource InkOnAccentBrush}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="22,12" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="RenderTransform" Value="translate(0px,0px)" />
        <Setter Property="Transitions">
            <Transitions>
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.12" Easing="CubicEaseOut" />
            </Transitions>
        </Setter>
    </Style>

    <Style Selector="Button.cardbutton">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>

    <Style Selector="Button.cardbutton:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <Style Selector="Button.accent /template/ ContentPresenter">
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="BoxShadow" Value="{StaticResource ShadowFlat}" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.14" />
                <BoxShadowsTransition Property="BoxShadow" Duration="0:0:0.14" />
            </Transitions>
        </Setter>
    </Style>

    <Style Selector="Button.accent:pointerover">
        <Setter Property="RenderTransform" Value="translate(-2px,-2px)" />
    </Style>

    <Style Selector="Button.accent:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AccentBrightBrush}" />
        <Setter Property="BoxShadow" Value="{StaticResource ShadowFlatHover}" />
    </Style>

    <Style Selector="Button.accent:pressed">
        <Setter Property="RenderTransform" Value="translate(1px,1px)" />
    </Style>

    <Style Selector="Button.accent:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AccentDeepBrush}" />
        <Setter Property="BoxShadow" Value="{StaticResource ShadowFlatFlush}" />
    </Style>

    <Style Selector="Button.ghost">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Padding" Value="18,11" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{DynamicResource HairlineBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.16" />
                <BrushTransition Property="BorderBrush" Duration="0:0:0.16" />
                <BrushTransition Property="Foreground" Duration="0:0:0.16" />
            </Transitions>
        </Setter>
    </Style>

    <Style Selector="Button.ghost:pointerover">
        <Setter Property="Background" Value="{DynamicResource BgRaisedHoverBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>

    <Style Selector="Button.ghost.disabled">
        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
        <Setter Property="Opacity" Value="0.55" />
    </Style>

    <Style Selector="Button.ghost.disabled:pointerover">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource HairlineBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
    </Style>

    <Style Selector="Button.ghost:pressed">
        <Setter Property="Background" Value="{DynamicResource BgInsetBrush}" />
    </Style>

    <Style Selector="Button.iconbtn">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        <Setter Property="Width" Value="42" />
        <Setter Property="Height" Value="42" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{DynamicResource HairlineBrush}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.14" />
                <BrushTransition Property="BorderBrush" Duration="0:0:0.14" />
                <BrushTransition Property="Foreground" Duration="0:0:0.14" />
            </Transitions>
        </Setter>
    </Style>

    <Style Selector="Button.iconbtn:pointerover">
        <Setter Property="Background" Value="{DynamicResource BgRaisedHoverBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>

    <!-- Nav items read like index-tabs: a flush left edge that grows an
         accent spine when active, rather than a filled rounded pill. -->
    <Style Selector="Button.navitem">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        <Setter Property="FontSize" Value="14.5" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Padding" Value="16,13" />
        <Setter Property="CornerRadius" Value="0,8,8,0" />
        <Setter Property="BorderThickness" Value="3,0,0,0" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.16" />
                <BrushTransition Property="BorderBrush" Duration="0:0:0.16" />
                <BrushTransition Property="Foreground" Duration="0:0:0.16" />
            </Transitions>
        </Setter>
    </Style>

    <Style Selector="Button.navitem:pointerover">
        <Setter Property="Background" Value="{DynamicResource BgRaisedBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>

    <Style Selector="Button.navitem.disabled">
        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
        <Setter Property="Opacity" Value="0.55" />
    </Style>

    <Style Selector="Button.navitem.disabled:pointerover">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
    </Style>

    <Style Selector="Button.navitem.active">
        <Setter Property="Background" Value="{DynamicResource BgRaisedBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style Selector="Button.navitem.active:pointerover">
        <Setter Property="Background" Value="{DynamicResource BgRaisedHoverBrush}" />
    </Style>

    <!-- Surfaces: flat fill, hairline border, hard "stamp" shadow -->
    <Style Selector="Border.glass">
        <Setter Property="Background" Value="{DynamicResource BgRaisedBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource HairlineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="BoxShadow" Value="{StaticResource ShadowFlat}" />
    </Style>

    <Style Selector="Border.card">
        <Setter Property="Background" Value="{DynamicResource BgRaisedBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource HairlineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="BoxShadow" Value="{StaticResource ShadowFlat}" />
        <Setter Property="RenderTransform" Value="translate(0px,0px)" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.16" />
                <BrushTransition Property="BorderBrush" Duration="0:0:0.16" />
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.16" Easing="CubicEaseOut" />
                <BoxShadowsTransition Property="BoxShadow" Duration="0:0:0.16" />
            </Transitions>
        </Setter>
    </Style>

    <Style Selector="Border.card:pointerover">
        <Setter Property="Background" Value="{DynamicResource BgRaisedHoverBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource HairlineBrightBrush}" />
        <Setter Property="RenderTransform" Value="translate(-2px,-2px)" />
        <Setter Property="BoxShadow" Value="{StaticResource ShadowFlatHover}" />
    </Style>

    <Style Selector="Border.coursecard">
        <Setter Property="Background" Value="{DynamicResource BgRaisedBrush}" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{DynamicResource HairlineBrush}" />
        <Setter Property="BoxShadow" Value="{StaticResource ShadowFlat}" />
        <Setter Property="RenderTransform" Value="translate(0px,0px)" />
        <Setter Property="ClipToBounds" Value="True" />
        <Setter Property="Transitions">
            <Transitions>
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.18" Easing="CubicEaseOut" />
                <BoxShadowsTransition Property="BoxShadow" Duration="0:0:0.18" />
                <BrushTransition Property="BorderBrush" Duration="0:0:0.16" />
            </Transitions>
        </Setter>
    </Style>

    <Style Selector="Border.coursecard:pointerover">
        <Setter Property="RenderTransform" Value="translate(-3px,-3px)" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
        <Setter Property="BoxShadow" Value="{StaticResource ShadowFlatHover}" />
    </Style>

    <Style Selector="Border.pill">
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="10,4" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style Selector="Border.stattile">
        <Setter Property="Background" Value="{DynamicResource BgRaisedBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource HairlineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="20" />
        <Setter Property="BoxShadow" Value="{StaticResource ShadowFlat}" />
        <Setter Property="RenderTransform" Value="translate(0px,0px)" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="BorderBrush" Duration="0:0:0.16" />
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.16" Easing="CubicEaseOut" />
                <BoxShadowsTransition Property="BoxShadow" Duration="0:0:0.16" />
            </Transitions>
        </Setter>
    </Style>

    <Style Selector="Border.stattile:pointerover">
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
        <Setter Property="RenderTransform" Value="translate(-2px,-2px)" />
        <Setter Property="BoxShadow" Value="{StaticResource ShadowFlatHover}" />
    </Style>

    <!-- Colour scheme picker swatches in Settings -->
    <Style Selector="Border.schemeswatch">
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Background" Value="{DynamicResource BgInsetBrush}" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="BorderBrush" Duration="0:0:0.14" />
                <BrushTransition Property="Background" Duration="0:0:0.14" />
            </Transitions>
        </Setter>
    </Style>

    <Style Selector="Border.schemeswatch:pointerover">
        <Setter Property="Background" Value="{DynamicResource BgRaisedHoverBrush}" />
    </Style>

    <Style Selector="Border.schemeswatch.selected">
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    </Style>

    <Style Selector="Border.listrow">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="16,14" />
        <Setter Property="BorderThickness" Value="1,1,1,1" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.14" />
                <BrushTransition Property="BorderBrush" Duration="0:0:0.14" />
            </Transitions>
        </Setter>
    </Style>

    <Style Selector="Border.listrow:pointerover">
        <Setter Property="Background" Value="{DynamicResource BgRaisedBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource HairlineBrush}" />
    </Style>

    <Style Selector="TextBox.search">
        <Setter Property="Background" Value="{DynamicResource BgInsetBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="CaretBrush" Value="{DynamicResource AccentBrightBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource HairlineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="14,11" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="BorderBrush" Duration="0:0:0.16" />
                <BrushTransition Property="Background" Duration="0:0:0.16" />
            </Transitions>
        </Setter>
    </Style>

    <Style Selector="TextBox.search:focus">
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
        <Setter Property="Background" Value="{DynamicResource BgInsetBrush}" />
    </Style>

    <Style Selector="TextBox.search:pointerover /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <Style Selector="ProgressBar.thin">
        <Setter Property="Height" Value="6" />
        <Setter Property="CornerRadius" Value="3" />
        <Setter Property="Background" Value="{DynamicResource BgInsetBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
        <Setter Property="MinWidth" Value="0" />
    </Style>

    <Style Selector="ScrollBar">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Width" Value="10" />
    </Style>

    <Style Selector="ScrollBar /template/ Thumb">
        <Setter Property="Background" Value="{DynamicResource HairlineStrongBrush}" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.16" />
            </Transitions>
        </Setter>
    </Style>

    <Style Selector="ScrollBar:pointerover /template/ Thumb">
        <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
    </Style>

    <Style Selector="TextBlock.h1">
        <Setter Property="FontSize" Value="26" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="LetterSpacing" Value="-0.3" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>

    <Style Selector="TextBlock.h2">
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>

    <Style Selector="TextBlock.h3">
        <Setter Property="FontSize" Value="15.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>

    <Style Selector="TextBlock.body">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        <Setter Property="LineHeight" Value="21" />
    </Style>

    <Style Selector="TextBlock.caption">
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
    </Style>

    <Style Selector="TextBlock.eyebrow">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource AccentBrightBrush}" />
        <Setter Property="LetterSpacing" Value="1.8" />
    </Style>

    <!-- Ledger figures: numeric stats set in monospace, like a gradebook -->
    <Style Selector="TextBlock.figure">
        <Setter Property="FontFamily" Value="monospace" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>

</Styles>
