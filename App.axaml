<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:YuCanvas.Models"
             xmlns:views="clr-namespace:YuCanvas.Views"
             xmlns:viewModels="clr-namespace:YuCanvas.Models.ViewModels"
             x:Class="YuCanvas.App"
             RequestedThemeVariant="Dark">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="/Styles/Colors.axaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Point Fluent's built-in controls (ToggleSwitch, etc.) at the
                 same amber accent instead of the default Fluent blue. -->
            <Color x:Key="SystemAccentColor">#E2A63C</Color>
            <Color x:Key="SystemAccentColorLight1">#EFBB57</Color>
            <Color x:Key="SystemAccentColorLight2">#F4CC7C</Color>
            <Color x:Key="SystemAccentColorLight3">#F8DDA3</Color>
            <Color x:Key="SystemAccentColorDark1">#B9812A</Color>
            <Color x:Key="SystemAccentColorDark2">#916620</Color>
            <Color x:Key="SystemAccentColorDark3">#6C4C18</Color>
        </ResourceDictionary>
    </Application.Resources>
    
    <Application.DataTemplates>
        <DataTemplate DataType="{x:Type viewModels:DashboardViewModel}">
            <views:DashboardView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:AssignmentsViewModel}">
            <views:AssignmentsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:AssignmentDetailViewModel}">
            <views:AssignmentDetailView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:SettingsViewModel}">
            <views:SettingsView />
        </DataTemplate>
    </Application.DataTemplates>

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://Avalonia.Controls.ColorPicker/Themes/Fluent/Fluent.xaml" />
        <StyleInclude Source="/Styles/Controls.axaml" />
    </Application.Styles>
</Application>
