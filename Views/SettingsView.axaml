<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:viewModels="clr-namespace:YuCanvas.Models.ViewModels"
             x:Class="YuCanvas.Views.SettingsView"
             x:DataType="viewModels:SettingsViewModel">

    <ScrollViewer Padding="40,24,40,32">
        <StackPanel Spacing="20">

            <StackPanel Spacing="14" MaxWidth="620" HorizontalAlignment="Left">
                <TextBlock Text="Einstellungen" Classes="h1" />
                <Grid>
                    <TextBox Classes="search" Text="{Binding SearchQuery}"
                             Watermark="Einstellungen durchsuchen …"
                             Padding="42,11,14,11" />
                    <TextBlock Text="⌕" FontSize="17" Foreground="{DynamicResource TextMutedBrush}"
                               VerticalAlignment="Center" Margin="15,0,0,0"
                               HorizontalAlignment="Left" IsHitTestVisible="False" />
                </Grid>
            </StackPanel>

            <WrapPanel Orientation="Horizontal">

                <!-- KONTO -->
                <StackPanel Spacing="10" Width="540" Margin="0,0,20,20"
                            IsVisible="{Binding ShowAccount}">
                    <TextBlock Text="KONTO" Classes="eyebrow" />
                    <Border Classes="glass" Padding="8" CornerRadius="10">
                        <StackPanel>
                            <Grid ColumnDefinitions="160,*" Margin="14,12">
                                <TextBlock Grid.Column="0" Text="Name" Classes="body"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding AccountName}" Classes="body"
                                           FontWeight="Medium" VerticalAlignment="Center" />
                            </Grid>
                            <Rectangle Height="1" Fill="{DynamicResource HairlineBrush}" Margin="14,0" />
                            <Grid ColumnDefinitions="160,*" Margin="14,12">
                                <TextBlock Grid.Column="0" Text="Nutzer-ID" Classes="body"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding AccountId}" Classes="body"
                                           FontWeight="Medium" VerticalAlignment="Center" />
                            </Grid>
                            <Rectangle Height="1" Fill="{DynamicResource HairlineBrush}" Margin="14,0" />
                            <Grid ColumnDefinitions="160,*" Margin="14,12">
                                <TextBlock Grid.Column="0" Text="Sprache" Classes="body"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding AccountLocale}" Classes="body"
                                           FontWeight="Medium" VerticalAlignment="Center" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- VERHALTEN -->
                <StackPanel Spacing="10" Width="540" Margin="0,0,20,20"
                            IsVisible="{Binding ShowBehavior}">
                    <TextBlock Text="VERHALTEN" Classes="eyebrow" />
                    <Border Classes="glass" Padding="8" CornerRadius="10">
                        <StackPanel>
                            <Grid ColumnDefinitions="*,Auto" Margin="14,12">
                                <StackPanel Grid.Column="0" Spacing="2">
                                    <TextBlock Text="Automatisch synchronisieren" Classes="body"
                                               FontWeight="Medium" />
                                    <TextBlock Text="Beim Start automatisch von Canvas laden" Classes="caption" />
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1" IsChecked="{Binding AutoSync}"
                                              VerticalAlignment="Center" />
                            </Grid>
                            <Rectangle Height="1" Fill="{DynamicResource HairlineBrush}" Margin="14,0" />
                            <Grid ColumnDefinitions="*,Auto" Margin="14,12">
                                <StackPanel Grid.Column="0" Spacing="2">
                                    <TextBlock Text="Mit Dashboard starten" Classes="body" FontWeight="Medium" />
                                    <TextBlock Text="Beim Öffnen direkt das Dashboard zeigen" Classes="caption" />
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1" IsChecked="{Binding StartOnDashboard}"
                                              VerticalAlignment="Center" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- DESIGN -->
                <StackPanel Spacing="10" Width="540" Margin="0,0,20,20"
                            IsVisible="{Binding ShowDesign}">
                    <TextBlock Text="DESIGN" Classes="eyebrow" />
                    <Border Classes="glass" Padding="18" CornerRadius="10">
                        <StackPanel Spacing="16">

                            <StackPanel Spacing="10">
                                <TextBlock Text="Farbschema" Classes="body" FontWeight="Medium" />
                                <StackPanel Orientation="Horizontal" Spacing="10">

                                    <Button Classes="cardbutton" Command="{Binding SelectPresetCommand}" CommandParameter="amber">
                                        <Border Classes="schemeswatch" Classes.selected="{Binding IsAmberSelected}" Width="86">
                                            <StackPanel Spacing="8" Margin="8,12" HorizontalAlignment="Center">
                                                <Ellipse Width="28" Height="28" Fill="#E2A63C" HorizontalAlignment="Center" />
                                                <TextBlock Text="Bernstein" FontSize="11.5" HorizontalAlignment="Center"
                                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                            </StackPanel>
                                        </Border>
                                    </Button>

                                    <Button Classes="cardbutton" Command="{Binding SelectPresetCommand}" CommandParameter="copper">
                                        <Border Classes="schemeswatch" Classes.selected="{Binding IsCopperSelected}" Width="86">
                                            <StackPanel Spacing="8" Margin="8,12" HorizontalAlignment="Center">
                                                <Ellipse Width="28" Height="28" Fill="#C9723C" HorizontalAlignment="Center" />
                                                <TextBlock Text="Kupfer" FontSize="11.5" HorizontalAlignment="Center"
                                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                            </StackPanel>
                                        </Border>
                                    </Button>

                                    <Button Classes="cardbutton" Command="{Binding SelectPresetCommand}" CommandParameter="sage">
                                        <Border Classes="schemeswatch" Classes.selected="{Binding IsSageSelected}" Width="86">
                                            <StackPanel Spacing="8" Margin="8,12" HorizontalAlignment="Center">
                                                <Ellipse Width="28" Height="28" Fill="#7A9B6E" HorizontalAlignment="Center" />
                                                <TextBlock Text="Salbei" FontSize="11.5" HorizontalAlignment="Center"
                                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                            </StackPanel>
                                        </Border>
                                    </Button>

                                    <Button Classes="cardbutton" Command="{Binding SelectPresetCommand}" CommandParameter="ink">
                                        <Border Classes="schemeswatch" Classes.selected="{Binding IsInkSelected}" Width="86">
                                            <StackPanel Spacing="8" Margin="8,12" HorizontalAlignment="Center">
                                                <Ellipse Width="28" Height="28" Fill="#5C86A6" HorizontalAlignment="Center" />
                                                <TextBlock Text="Tinte" FontSize="11.5" HorizontalAlignment="Center"
                                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                            </StackPanel>
                                        </Border>
                                    </Button>

                                    <Button Classes="cardbutton" Command="{Binding SelectPresetCommand}" CommandParameter="cherry">
                                        <Border Classes="schemeswatch" Classes.selected="{Binding IsCherrySelected}" Width="86">
                                            <StackPanel Spacing="8" Margin="8,12" HorizontalAlignment="Center">
                                                <Ellipse Width="28" Height="28" Fill="#B4485A" HorizontalAlignment="Center" />
                                                <TextBlock Text="Kirsch" FontSize="11.5" HorizontalAlignment="Center"
                                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                            </StackPanel>
                                        </Border>
                                    </Button>

                                </StackPanel>
                            </StackPanel>

                            <Rectangle Height="1" Fill="{DynamicResource HairlineBrush}" />

                            <Border Classes="schemeswatch" Classes.selected="{Binding IsCustomSelected}" Padding="14">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="Eigenes Farbschema" Classes="body" FontWeight="Medium" />
                                    <Grid ColumnDefinitions="Auto,10,*,10,Auto">
                                        <ColorPicker Grid.Column="0" Color="{Binding CustomAccentColor, Mode=TwoWay}" />
                                        <TextBox Grid.Column="2" Classes="search" Text="{Binding CustomThemeName}"
                                                 Watermark="Name (optional)" />
                                        <Button Grid.Column="4" Classes="accent" Command="{Binding ApplyCustomThemeCommand}">
                                            <TextBlock Text="Anwenden" FontSize="13" />
                                        </Button>
                                    </Grid>
                                    <TextBlock Classes="caption" TextWrapping="Wrap"
                                               Text="Die Akzentfarbe wird beim Wählen sofort als Vorschau gezeigt — „Anwenden“ speichert sie als eigenes Schema." />
                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- CANVAS-VERBINDUNG -->
                <StackPanel Spacing="10" Width="540" Margin="0,0,20,20"
                            IsVisible="{Binding ShowConnection}">
                    <TextBlock Text="CANVAS-VERBINDUNG" Classes="eyebrow" />
                    <Border Classes="glass" Padding="18" CornerRadius="10">
                        <StackPanel Spacing="16">
                            <StackPanel Spacing="6">
                                <TextBlock Text="Canvas-URL" Classes="caption" />
                                <TextBox Classes="search" Text="{Binding CanvasBaseUrl}"
                                         Watermark="https://deine-hochschule.instructure.com" />
                            </StackPanel>
                            <StackPanel Spacing="6">
                                <TextBlock Text="Zugriffstoken" Classes="caption" />
                                <TextBox Classes="search" Text="{Binding CanvasToken}"
                                         PasswordChar="•" Watermark="Dein Canvas-Token" />
                                <TextBlock Text="Wird unverschlüsselt lokal gespeichert."
                                           FontSize="11" Foreground="{DynamicResource WarnBrush}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- AKTUALISIERUNGEN -->
                <StackPanel Spacing="10" Width="540" Margin="0,0,20,20"
                            IsVisible="{Binding ShowUpdates}">
                    <TextBlock Text="AKTUALISIERUNGEN" Classes="eyebrow" />
                    <Border Classes="glass" Padding="18" CornerRadius="10">
                        <StackPanel Spacing="16">

                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Grid.Column="0" Spacing="2">
                                    <TextBlock Text="Installierte Version" Classes="body" FontWeight="Medium" />
                                    <TextBlock Text="{Binding CurrentVersionLabel}" Classes="caption" />
                                </StackPanel>

                                <Border Grid.Column="1" Classes="pill" VerticalAlignment="Center"
                                        Background="#1FCC7A2E" BorderBrush="Transparent"
                                        IsVisible="{Binding IsUpdateAvailable}">
                                    <TextBlock Text="Update verfügbar" FontSize="11" FontWeight="SemiBold"
                                               Foreground="{DynamicResource WarnBrush}" />
                                </Border>

                                <Border Grid.Column="1" Classes="pill" VerticalAlignment="Center"
                                        Background="#1F6FA35B" BorderBrush="Transparent"
                                        IsVisible="{Binding !IsUpdateAvailable}">
                                    <TextBlock Text="Aktuell" FontSize="11" FontWeight="SemiBold"
                                               Foreground="{DynamicResource SuccessBrush}" />
                                </Border>
                            </Grid>

                            <Rectangle Height="1" Fill="{DynamicResource HairlineBrush}"
                                       IsVisible="{Binding IsUpdateAvailable}" />

                            <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding IsUpdateAvailable}">
                                <StackPanel Grid.Column="0" Spacing="2">
                                    <TextBlock Text="Neue Version" Classes="body" FontWeight="Medium" />
                                    <TextBlock Text="{Binding LatestVersionLabel}" Classes="caption" />
                                </StackPanel>
                                <Button Grid.Column="1" Classes="ghost" VerticalAlignment="Center"
                                        Command="{Binding OpenChangelogCommand}">
                                    <TextBlock Text="Änderungen ansehen" FontSize="13" />
                                </Button>
                            </Grid>

                            <Rectangle Height="1" Fill="{DynamicResource HairlineBrush}" />

                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="Nach Updates suchen" Classes="body" FontWeight="Medium" />
                                    <TextBlock Text="{Binding UpdateStatusText}" Classes="caption" />
                                </StackPanel>
                                <Button Grid.Column="1" Classes="ghost" Command="{Binding CheckForUpdatesCommand}"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="{Binding CheckUpdatesButtonText}" FontSize="13" />
                                </Button>
                            </Grid>

                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- DATEN -->
                <StackPanel Spacing="10" Width="540" Margin="0,0,20,20"
                            IsVisible="{Binding ShowData}">
                    <TextBlock Text="DATEN" Classes="eyebrow" />
                    <Border Classes="glass" Padding="18" CornerRadius="10">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="Zwischenspeicher leeren" Classes="body" FontWeight="Medium" />
                                <TextBlock Text="Löscht die lokal gespeicherten Kursdaten" Classes="caption" />
                            </StackPanel>
                            <Button Grid.Column="1" Classes="ghost" Command="{Binding ClearCacheCommand}"
                                    VerticalAlignment="Center">
                                <TextBlock Text="Cache leeren" FontSize="13" />
                            </Button>
                        </Grid>
                    </Border>
                </StackPanel>

            </WrapPanel>

            <!-- KEINE TREFFER -->
            <Border Classes="glass" Padding="24" CornerRadius="10" Width="540"
                    HorizontalAlignment="Left" IsVisible="{Binding NoResults}">
                <TextBlock Text="Keine Einstellungen gefunden." Classes="body"
                           HorizontalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}" />
            </Border>

            <!-- SPEICHERN -->
            <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                <Button Classes="accent" Command="{Binding SaveCommand}">
                    <TextBlock Text="Speichern" FontSize="13.5" />
                </Button>
                <TextBlock Text="{Binding StatusText}" Classes="caption" VerticalAlignment="Center" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>